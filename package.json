{
  "name": "nexucode",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist-server",
    "start": "node dist-server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "admin:hash": "tsx server/scripts/hashAdminPassword.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@supabase/server": "^1.6.0",
    "@supabase/supabase-js": "^2.57.4",
    "adm-zip": "^0.6.1",
    "esbuild-wasm": "^0.24.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.446.0",
    "or": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@eslint/js": "^9.9.1",
    "@octokit/rest": "^21.0.2",
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "globals": "^15.9.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.68.4",
    "postcss": "^8.4.35",
    "stripe": "^17.2.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.0"
  }
}
