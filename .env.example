# ============================================================
# Copie este arquivo para ".env" e preencha os valores.
# Nada aqui funciona "de fábrica" — cada bloco é opcional e liga
# uma funcionalidade quando a chave correspondente é preenchida.
# ============================================================

# --- Supabase (frontend, precisa do prefixo VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# --- Supabase (backend — Service Role, NUNCA exponha no frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Provedores de IA (o seletor de modelo só mostra o que tiver chave) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM — catálogo com os modelos Nemotron (https://build.nvidia.com)
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# --- Deep search (busca profunda) — https://tavily.com ---
TAVILY_API_KEY=

# --- GitHub (Personal Access Token com escopo "repo") ---
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# --- Stripe (planos/assinaturas) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=15
STRIPE_PRICE_YEARLY=160

# --- Geral ---
APP_BASE_URL=http://localhost:5173
PORT=8787

# --- Limite de mensagens/dia do plano free (monetização) ---
# Usuários com plan='pro' ou role='admin' (tabela profiles) não têm limite.
FREE_DAILY_MESSAGE_LIMIT=30

# --- Rate limiting das rotas de IA (proteção contra abuso) ---
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# --- Sandbox de execução de código (Cowork) ---
# Por padrão usa a instância pública do Piston (grátis, sem chave, mas com
# rate limit próprio). Para produção com volume alto, rode sua própria
# instância (https://github.com/engineer-man/piston) e aponte a URL aqui.
PISTON_API_URL=https://emkc.org/api/v2/piston

# --- Login do Admin (separado do login normal) ---
# 1) Rode: npm run admin:hash -- "sua-senha-aqui"
# 2) Cole o hash gerado em ADMIN_PASSWORD_HASH abaixo
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
